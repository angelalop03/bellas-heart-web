{
  "name": "bellas-heart",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/migrate.mjs && tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:start": "docker start bellas-pg || docker run -d --name bellas-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=bellas -p 55432:5432 postgres:17-alpine",
    "db:migrate": "node scripts/migrate.mjs",
    "db:stop": "docker stop bellas-pg"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.2.6",
    "@fontsource/caveat": "5.2.6",
    "bcryptjs": "3.0.2",
    "jose": "6.0.11",
    "lucide-react": "0.511.0",
    "pg": "8.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/pg": "8.15.4",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
